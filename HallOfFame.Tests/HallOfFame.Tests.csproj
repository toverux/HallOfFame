<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <!-- xUnit v3 builds the tests as their own executable. On Linux, `dotnet test` runs it under
             Mono through Microsoft.Testing.Platform, which the root global.json opts into: VSTest
             dropped its Mono host for .NET Framework tests in 18.10 (microsoft/vstest#16158). -->
        <OutputType>Exe</OutputType>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>

        <!-- Resolve the game's managed assemblies the same way the mod does, from the User-scoped
             CSII_MANAGEDPATH environment variable, or the process one on Linux, which has no user
             scope. -->
        <ManagedPath>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</ManagedPath>
        <ManagedPath Condition="'$(ManagedPath)' == ''">$(CSII_MANAGEDPATH)</ManagedPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PolySharp" Version="1.16.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Game assemblies pulled in by the mod's domain types, copied next to the tests along with the
         non-framework dependencies MSBuild finds for them, so the test process loads them like its
         own. -->
    <ItemGroup>
        <Reference Include="Colossal.Core">
            <HintPath>$(ManagedPath)\Colossal.Core.dll</HintPath>
        </Reference>
        <Reference Include="Colossal.UI.Binding">
            <HintPath>$(ManagedPath)\Colossal.UI.Binding.dll</HintPath>
        </Reference>
        <Reference Include="Game">
            <HintPath>$(ManagedPath)\Game.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HallOfFame\HallOfFame.csproj" />
    </ItemGroup>
</Project>
