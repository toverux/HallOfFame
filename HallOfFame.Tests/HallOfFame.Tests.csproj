<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The off-engine tests run on CoreCLR, alike on Linux and Windows: xUnit v3 builds them as
         their own executable, which `dotnet test` starts through Microsoft.Testing.Platform (the
         root global.json opts into it) and an IDE or a shell can launch directly. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- Resolve the game's managed assemblies the same way the mod does, from the User-scoped
         CSII_MANAGEDPATH environment variable, or the process one on Linux, which has no user
         scope. -->
    <ManagedPath>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(CSII_MANAGEDPATH)</ManagedPath>

    <!-- The mod targets net48 on purpose: CoreCLR runs it through its mscorlib facade. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <!-- The game assemblies the mod compiles against, copied next to the tests with the dependencies
       MSBuild finds for them in the same folder, so the test process loads them like its own. -->
  <ItemGroup>
    <Reference Include="Game" HintPath="$(ManagedPath)\Game.dll" />
    <Reference Include="Colossal.Core" HintPath="$(ManagedPath)\Colossal.Core.dll" />
    <Reference Include="Colossal.Logging" HintPath="$(ManagedPath)\Colossal.Logging.dll" />
    <Reference Include="Colossal.IO.AssetDatabase" HintPath="$(ManagedPath)\Colossal.IO.AssetDatabase.dll" />
    <Reference Include="Colossal.UI" HintPath="$(ManagedPath)\Colossal.UI.dll" />
    <Reference Include="Colossal.UI.Binding" HintPath="$(ManagedPath)\Colossal.UI.Binding.dll" />
    <Reference Include="Colossal.Localization" HintPath="$(ManagedPath)\Colossal.Localization.dll" />
    <Reference Include="Colossal.PSI.Common" HintPath="$(ManagedPath)\Colossal.PSI.Common.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedPath)\Unity.InputSystem.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedPath)\UnityEngine.CoreModule.dll" />
    <Reference Include="Unity.Burst" HintPath="$(ManagedPath)\Unity.Burst.dll" />
    <Reference Include="Unity.Collections" HintPath="$(ManagedPath)\Unity.Collections.dll" />
    <Reference Include="Unity.Entities" HintPath="$(ManagedPath)\Unity.Entities.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(ManagedPath)\Unity.Mathematics.dll" />
    <Reference Include="TND.Upscaling.Framework.Runtime.Core" HintPath="$(ManagedPath)\TND.Upscaling.Framework.Runtime.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HallOfFame\HallOfFame.csproj" />
  </ItemGroup>

  <!-- The native-call shim (Shim/UnityNativeCalls.cs) supplies UnityEngine.CoreModule itself: left
       off the app's dependencies, the default load context asks the shim's resolving handler for
       it. The original is copied next to the tests under another name, for the shim to rewrite. -->
  <Target Name="HoldBackUnityCoreModule" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(Filename)%(Extension)' == 'UnityEngine.CoreModule.dll'" />
      <ReferencePath Update="@(ReferencePath)" Condition="'%(Filename)' == 'UnityEngine.CoreModule'"
                     Private="false" />
      <None Include="$(ManagedPath)\UnityEngine.CoreModule.dll" Link="UnityEngine.CoreModule.original"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
