{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec bun -- bun \"$CLAUDE_PROJECT_DIR/.agents/hooks/check-line-length.ts\" --extensions ts,tsx,scss,cs --suppressions \"oxlint-disable|@ts-expect-error|#pragma warning|ReSharper disable|SuppressMessage\""
          },
          {
            "type": "command",
            "command": "mise exec bun -- bun \"$CLAUDE_PROJECT_DIR/.agents/hooks/check-em-dashes.ts\" --allow-extensions md,txt"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "coherent-gameface@csmodding": true,
    "unity-devtools@csmodding": true,
    "cs2-modding@csmodding": true
  },
  "extraKnownMarketplaces": {
    "csmodding": {
      "source": {
        "source": "github",
        "repo": "CitiesSkylinesModding/agents-plugins"
      }
    }
  }
}
